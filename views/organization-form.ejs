<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">Community partners</p>
    <h1><%= heading %></h1>
    <p>Share the details neighbors need to learn about this organization.</p>
  </section>
  <form class="form-card" action="<%= action %>" method="post">
    <% if (Object.keys(errors).length > 0) { %>
    <div class="form-errors" role="alert">
      <p>Please correct the highlighted fields.</p>
    </div>
    <% } %>
    <div class="form-field">
      <label for="organization_name">Organization name</label>
      <input id="organization_name" name="organization_name" type="text"
        value="<%= organization.organization_name %>" maxlength="150" required
        <%= errors.organization_name ? 'aria-invalid="true" aria-describedby="organization_name_error"' : '' %>>
      <% if (errors.organization_name) { %><p class="field-error" id="organization_name_error"><%= errors.organization_name %></p><% } %>
    </div>
    <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5" required
        <%= errors.description ? 'aria-invalid="true" aria-describedby="description_error"' : '' %>><%= organization.description %></textarea>
      <% if (errors.description) { %><p class="field-error" id="description_error"><%= errors.description %></p><% } %>
    </div>
    <div class="form-field">
      <label for="contact_email">Contact email</label>
      <input id="contact_email" name="contact_email" type="email"
        value="<%= organization.contact_email %>" maxlength="254" required
        <%= errors.contact_email ? 'aria-invalid="true" aria-describedby="contact_email_error"' : '' %>>
      <% if (errors.contact_email) { %><p class="field-error" id="contact_email_error"><%= errors.contact_email %></p><% } %>
    </div>
    <div class="form-field">
      <label for="logo">Logo image URL <span class="optional-label">(optional)</span></label>
      <input id="logo" name="logo" type="url" value="<%= organization.logo || '' %>">
      <% if (errors.logo) { %><p class="field-error" id="logo_error"><%= errors.logo %></p><% } %>
    </div>
    <div class="form-actions">
      <button class="button" type="submit"><%= submitLabel %></button>
      <a class="text-link" href="/organizations">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
