<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">Service project</p>
    <h1><%= project.project_name %></h1>
  </section>
  <article class="detail-card">
    <p class="project-date">
      <time datetime="<%= project.project_date.toISOString().slice(0, 10) %>">
        <%= new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(project.project_date) %>
      </time>
    </p>
    <p><%= project.description %></p>
    <p>Location: <%= project.location %></p>
    <p>
      Organization:
      <a class="item-link" href="/organization/<%= project.organization_id %>">
        <%= project.organization_name %>
      </a>
    </p>
    <section class="page-section" aria-label="Project categories">
      <h2>Categories</h2>
      <% if (categories.length > 0) { %>
      <ul class="topic-list">
        <% categories.forEach((category) => { %>
        <li>
          <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="empty-state">No categories are assigned to this project yet.</p>
      <% } %>
    </section>
  </article>
</main>
<%- include('partials/footer') %>
