<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">Service project</p>
    <h1><%= project.project_name %></h1>
    <p><%= project.description %></p>
  </section>
  <section class="project-details" aria-label="Project details">
    <p>Organized by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p>Project date: <time datetime="<%= project.project_date %>"><%= new Date(`${project.project_date}T00:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', dateStyle: 'long' }) %></time></p>
    <p>Location: <%= project.location %></p>
    <h2>Categories</h2>
    <% if (categories.length > 0) { %>
    <ul class="topic-list" aria-label="Project categories">
      <% categories.forEach((category) => { %>
      <li><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></li>
      <% }) %>
    </ul>
    <% } else { %>
    <p class="empty-state">No categories have been assigned to this project.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
