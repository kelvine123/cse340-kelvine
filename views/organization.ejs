<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">Community partner</p>
    <h1><%= organization.organization_name %></h1>
    <p><%= organization.description %></p>
  </section>
  <section class="page-section entity-list" aria-label="Projects by this organization">
    <h2>Service projects</h2>
    <% projects.forEach((project) => { %>
    <article class="entity-card">
      <h3><a href="/project/<%= project.project_id %>"><%= project.project_name %></a></h3>
      <p><%= project.description %></p>
    </article>
    <% }) %>
    <% if (projects.length === 0) { %>
    <p class="empty-state">This organization does not have any service projects yet.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
