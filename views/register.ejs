<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content auth-page">
  <section class="auth-card">
    <% if (flashMessage) { %><p class="flash-message" role="status"><%= flashMessage %></p><% } %>
    <p class="eyebrow">Join the community</p>
    <h1>Create an account</h1>
    <form action="/register" method="post" class="form-card">
      <div class="form-field">
        <label for="first_name">First name</label>
        <input id="first_name" name="first_name" type="text" value="<%= values.first_name || '' %>" required>
        <% if (errors.first_name) { %><p class="field-error"><%= errors.first_name %></p><% } %>
      </div>
      <div class="form-field">
        <label for="last_name">Last name</label>
        <input id="last_name" name="last_name" type="text" value="<%= values.last_name || '' %>" required>
        <% if (errors.last_name) { %><p class="field-error"><%= errors.last_name %></p><% } %>
      </div>
      <div class="form-field">
        <label for="username">Email</label>
        <input id="username" name="username" type="email" value="<%= values.username || '' %>" autocomplete="username" required>
        <% if (errors.username) { %><p class="field-error"><%= errors.username %></p><% } %>
      </div>
      <div class="form-field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>
        <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Register</button>
        <a class="text-link" href="/login">Already have an account?</a>
      </div>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
