<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content auth-page">
  <section class="auth-card">
    <% if (flashMessage) { %><p class="flash-message" role="status"><%= flashMessage %></p><% } %>
    <p class="eyebrow">Welcome back</p>
    <h1>Log in</h1>
    <% if (errors.login) { %><p class="form-errors" role="alert"><%= errors.login %></p><% } %>
    <form action="/login" method="post" class="form-card">
      <div class="form-field">
        <label for="username">Email</label>
        <input id="username" name="username" type="email" value="<%= values.username || '' %>" autocomplete="username" required>
      </div>
      <div class="form-field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Log in</button>
        <a class="text-link" href="/register">Create an account</a>
      </div>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
