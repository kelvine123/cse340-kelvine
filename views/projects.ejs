<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">From intention to impact</p>
    <h1>Projects that bring community ideas to life.</h1>
    <p>Explore community-led work across learning, the environment, and health and wellbeing.</p>
  </section>
  <section class="entity-list" aria-label="Upcoming service projects">
    <% projects.forEach((project) => { %>
    <article class="entity-card">
      <p class="card-label">Upcoming project · <time datetime="<%= project.project_date %>"><%= new Date(`${project.project_date}T00:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', dateStyle: 'long' }) %></time></p>
      <h2><a href="/project/<%= project.project_id %>"><%= project.project_name %></a></h2>
      <p><%= project.description %></p>
      <p>Location: <%= project.location %></p>
      <p>Organized by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    </article>
    <% }) %>
    <% if (projects.length === 0) { %>
    <p class="empty-state">There are no upcoming projects to show yet.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>