<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">From intention to impact</p>
    <h1>Projects that bring community ideas to life.</h1>
    <p>Explore community-led work across learning, the environment, and health and wellbeing.</p>
  </section>
  <section class="project-grid" aria-label="Service projects">
    <% projects.forEach((project) => { %>
    <article class="project-card">
      <div class="card-copy">
        <p class="card-label">Service project</p>
        <h2><%= project.project_name %></h2>
        <p><%= project.description %></p>
        <p>Location: <%= project.location %></p>
        <p>Organization: <%= project.organization_name %></p>
      </div>
    </article>
    <% }) %>
    <% if (projects.length === 0) { %>
    <p class="empty-state">There are no service projects to show yet.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>