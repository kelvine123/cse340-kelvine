<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">From intention to impact</p>
    <h1>Upcoming projects that bring community ideas to life.</h1>
    <p>Explore the next community projects across learning, the environment, and health and wellbeing.</p>
  </section>
  <section class="project-grid" aria-label="Service projects">
    <% const dateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }); %>
    <% projects.forEach((project) => { %>
    <article class="project-card">
      <div class="card-copy">
        <p class="card-label">Service project</p>
        <p class="project-date">
          <time datetime="<%= project.project_date.toISOString().slice(0, 10) %>">
            <%= dateFormatter.format(project.project_date) %>
          </time>
        </p>
        <h2>
          <a class="item-link" href="/project/<%= project.project_id %>">
            <%= project.project_name %>
          </a>
        </h2>
        <p><%= project.description %></p>
        <p>Location: <%= project.location %></p>
        <p>
          Organization:
          <a class="item-link" href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
          </a>
        </p>
      </div>
    </article>
    <% }) %>
    <% if (projects.length === 0) { %>
    <p class="empty-state">There are no service projects to show yet.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>