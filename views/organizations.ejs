<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">People making things happen</p>
    <h1>Meet the organizations behind local change.</h1>
    <p>Community progress is powered by people who show up, share what they know, and make room for others to take part.</p>
  </section>
  <section class="feature-grid" aria-label="Partner organizations">
    <% organizations.forEach((organization) => { %>
    <article class="feature-card">
      <% if (organization.logo) { %>
      <img src="<%= organization.logo %>" alt="<%= organization.organization_name %> logo">
      <% } %>
      <div class="card-copy">
        <p class="card-label">Community partner</p>
        <h2><%= organization.organization_name %></h2>
        <p><%= organization.description %></p>
        <a class="card-link" href="mailto:<%= organization.contact_email %>">Contact <%= organization.organization_name %></a>
      </div>
    </article>
    <% }) %>
    <% if (organizations.length === 0) { %>
    <p class="empty-state">There are no organizations to show yet.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>