<%- include('partials/header', { pageTitle, currentPage }) %>
<main class="container page-content">
  <section class="page-hero">
    <p class="eyebrow">Categories</p>
    <h1>Create a category</h1>
    <p>Add a focus area to help neighbors find related service projects.</p>
  </section>
  <form class="form-card" action="/new-category" method="post">
    <% if (Object.keys(errors).length > 0) { %>
    <div class="form-errors" role="alert">
      <p>Please correct the following:</p>
      <ul><li><%= errors.category_name %></li></ul>
    </div>
    <% } %>
    <div class="form-field">
      <label for="category_name">Category name</label>
      <input id="category_name" name="category_name" type="text" value="<%= category.category_name %>"
        maxlength="100" required <%= errors.category_name ? 'aria-invalid="true" aria-describedby="category_name_error"' : '' %>>
      <% if (errors.category_name) { %>
      <p class="field-error" id="category_name_error"><%= errors.category_name %></p>
      <% } %>
    </div>
    <div class="form-actions">
      <button class="button" type="submit">Create category</button>
      <a class="text-link" href="/categories">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
